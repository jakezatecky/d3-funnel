{
  "name": "d3-funnel",
  "version": "2.3.0",
  "description": "A library for rendering SVG funnel charts using D3.js",
  "author": "Jake Zatecky",
  "license": "MIT",
  "keywords": [
    "d3",
    "funnel",
    "pyramid",
    "svg",
    "chart"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakezatecky/d3-funnel.git"
  },
  "homepage": "https://jakezatecky.github.io/d3-funnel/",
  "bugs": "https://github.com/jakezatecky/d3-funnel/issues",
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "imports": {
    "#js/*": "./src/d3-funnel/*"
  },
  "exports": "./src/index.js",
  "main": "./src/index.js",
  "unpkg": "./dist/d3-funnel.min.js",
  "jsdelivr": "./dist/d3-funnel.min.js",
  "scripts": {
    "build": "webpack",
    "build:examples": "webpack --config=webpack.config.examples.js --mode=production",
    "build:test": "webpack --config=webpack.config.test.js",
    "examples": "webpack serve --config=webpack.config.examples.js",
    "format": "prettier --write \"examples/src/scss/**/*.scss\"",
    "lint": "npm run lint:script && npm run lint:style && npm run lint:browser",
    "lint:browser": "es-check checkBrowser \"src/**/*.js\" --module --checkFeatures",
    "lint:script": "eslint .",
    "lint:style": "stylelint \"examples/src/scss/**/*.scss\" && prettier --check \"examples/src/scss/**/*.scss\"",
    "prepublishOnly": "npm test && npm run build && npm run validate:package",
    "test": "npm run lint && npm run test:script",
    "test:script": "npm run build:test && node test/test.js",
    "validate:package": "es-check checkBrowser dist/d3-funnel.min.js --checkFeatures && publint --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/reem-kufi": "^5.3.0",
    "chai": "^6.0.1",
    "css-loader": "^7.0.0",
    "d3": "^7.0.0",
    "es-check": "^9.8.1",
    "eslint": "^10.1.0",
    "eslint-config-takiyon": "^5.0.0",
    "eslint-plugin-import-x": "^4.16.2",
    "globals": "^17.6.0",
    "html-bundler-webpack-plugin": "^4.21.1",
    "lodash": "^4.17.21",
    "mocha": "^12.0.1",
    "normalize.css": "^8.0.1",
    "playwright": "^1.5.2",
    "prettier": "^3.1.1",
    "publint": "^0.3.24",
    "sass": "^1.69.5",
    "sass-loader": "^17.0.0",
    "sinon": "^22.0.0",
    "stylelint": "^17.9.1",
    "stylelint-config-takiyon": "^7.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.20.0",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "d3-array": "^3.0.1",
    "d3-ease": "^3.0.1",
    "d3-scale": "^4.0.0",
    "d3-scale-chromatic": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.0",
    "nanoid": "^6.0.1"
  }
}
